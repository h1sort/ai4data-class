# Copia este archivo a .env y rellena tus valores: cp .env.example .env
# .env está en .gitignore. Nunca subas tus claves al repositorio.

# --- Jev (TypeSafe) · Clase 2: columna de juicio con confianza ---------------
# Clave de API en https://console.typesafe.ai (acceso anticipado).
TYPESAFE_API_KEY=apikey_...

# --- Databricks · Clase 2: el warehouse ------------------------------------
# URL de tu workspace, sin la barra final.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
# Token personal de administrador (User Settings → Developer → Access tokens).
# Se usa para la configuración: esquemas, volumen, service principal y permisos.
DATABRICKS_TOKEN=dapi...
# Token del service principal `ai4data-agent`, con permisos limitados a los
# esquemas workspace.ai4data*. El agente usa este durante la demo:
#   DATABRICKS_TOKEN=$DATABRICKS_AGENT_TOKEN codex
# Cómo crearlo: demos/clase-02/databricks/10_agent_principal.md
DATABRICKS_AGENT_TOKEN=dapi...

# El ID del SQL warehouse no va aquí: se pasa con --warehouse-id a
# demos/clase-02/databricks/run_sql.sh (tiene un valor por defecto).

# --- Cloudflare D1 (fuente OLTP) --------------------------------------------
# No va en este archivo: wrangler usa su propio login (`npx wrangler login`).
